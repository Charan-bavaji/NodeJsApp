// Assignment #2: GitHub Webhook Integration
// Same stages as Assignment #1, but the job is configured to trigger
// automatically on a GitHub push via a webhook (ngrok tunnel -> /github-webhook/).
//
// NOTE: The actual trigger is enabled in the Jenkins job UI via
// "GitHub hook trigger for GITScm polling" under Build Triggers.
// The `triggers { githubPush() }` block below is the pipeline-as-code
// equivalent of checking that box, so the trigger config lives in git too.

pipeline {
    agent any

    triggers {
        githubPush()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'npm test'
            }
        }

        stage('Build') {
            steps {
                sh 'npm run build'
            }
        }
    }

    post {
        success {
            echo 'Build succeeded — archiving artifacts (excluding node_modules)...'
            archiveArtifacts artifacts: 'dist/**/*', excludes: 'node_modules/**', fingerprint: true
        }
        failure {
            echo 'Build failed. Check console output for details.'
        }
    }
}
